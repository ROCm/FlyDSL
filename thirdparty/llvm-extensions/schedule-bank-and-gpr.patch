diff --git a/llvm/test/CodeGen/AMDGPU/sched-agpr-any-chain.ll b/llvm/test/CodeGen/AMDGPU/sched-agpr-any-chain.ll
new file mode 100644
index 0000000000..127d8d33df
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-agpr-any-chain.ll
@@ -0,0 +1,103 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx950 -stop-after=amdgpu-sched-bank < %s | FileCheck %s
+; RUN: llc -mtriple=amdgcn -mcpu=gfx950 < %s | FileCheck -check-prefix=GCN %s
+
+; Each accumulator chain of regnum -1 strict AGPR pins gets its own AGPR index.
+; Two chains that share their zero initial value stay separate.
+
+declare <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float>, i32, i32)
+declare <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half>, <4 x half>, <4 x float>, i32, i32, i32)
+
+; CHECK-LABEL: name: two_chains
+; CHECK: A_SCHEDULE_AGPR_B128 {{.*}}%{{[0-9]+}}, 0, 1
+; CHECK: A_SCHEDULE_AGPR_B128 {{.*}}%{{[0-9]+}}, 4, 1
+define amdgpu_kernel void @two_chains(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n) #0 {
+entry:
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
+  %c0 = phi <4 x float> [ zeroinitializer, %entry ], [ %p0, %loop ]
+  %c1 = phi <4 x float> [ zeroinitializer, %entry ], [ %p1, %loop ]
+  %pa = getelementptr <4 x half>, ptr addrspace(1) %in, i32 %i
+  %a = load <4 x half>, ptr addrspace(1) %pa
+  %r0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %a, <4 x float> %c0, i32 0, i32 0, i32 0)
+  %p0 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r0, i32 -1, i32 1)
+  %r1 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %a, <4 x float> %c1, i32 0, i32 0, i32 0)
+  %p1 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r1, i32 -1, i32 1)
+  %i.next = add i32 %i, 1
+  %cond = icmp slt i32 %i.next, %n
+  br i1 %cond, label %loop, label %exit
+
+exit:
+  %o1 = getelementptr <4 x float>, ptr addrspace(1) %out, i32 1
+  store <4 x float> %p0, ptr addrspace(1) %out
+  store <4 x float> %p1, ptr addrspace(1) %o1
+  ret void
+}
+
+; One chain from the MFMA before the loop, through the loop PHI and the
+; accumulator input of the MFMA after the loop.
+; CHECK-LABEL: name: loop_chain
+; CHECK-COUNT-3: A_SCHEDULE_AGPR_B128 {{.*}}%{{[0-9]+}}, 0, 1
+; CHECK-NOT: A_SCHEDULE_AGPR_B128
+; GCN-LABEL: {{^}}loop_chain:
+; GCN-NOT: v_accvgpr_mov
+; GCN: v_mfma_f32_16x16x16_f16 a[0:3], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[0:3]
+; GCN-NOT: v_accvgpr_mov
+; GCN: v_mfma_f32_16x16x16_f16 a[0:3], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[0:3]
+; GCN-NOT: v_accvgpr_mov
+; GCN: v_mfma_f32_16x16x16_f16 a[0:3], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[0:3]
+; GCN-NOT: v_accvgpr_mov
+; GCN: s_endpgm
+define amdgpu_kernel void @loop_chain(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n, <4 x float> %init) #0 {
+entry:
+  %a0 = load <4 x half>, ptr addrspace(1) %in
+  %r0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a0, <4 x half> %a0, <4 x float> %init, i32 0, i32 0, i32 0)
+  %p0 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r0, i32 -1, i32 1)
+  br label %loop
+
+loop:
+  %i = phi i32 [ 1, %entry ], [ %i.next, %loop ]
+  %c = phi <4 x float> [ %p0, %entry ], [ %p, %loop ]
+  %pa = getelementptr <4 x half>, ptr addrspace(1) %in, i32 %i
+  %a = load <4 x half>, ptr addrspace(1) %pa
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %a, <4 x float> %c, i32 0, i32 0, i32 0)
+  %p = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r, i32 -1, i32 1)
+  %i.next = add i32 %i, 1
+  %cond = icmp slt i32 %i.next, %n
+  br i1 %cond, label %loop, label %exit
+
+exit:
+  %b = load <4 x half>, ptr addrspace(1) %in
+  %e = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %b, <4 x half> %b, <4 x float> %p, i32 0, i32 0, i32 0)
+  %q = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %e, i32 -1, i32 1)
+  store <4 x float> %q, ptr addrspace(1) %out
+  ret void
+}
+
+; An exact pin takes a0..a3, so the chain starts at a4.
+; CHECK-LABEL: name: after_exact
+; CHECK: A_SCHEDULE_AGPR_B128 {{.*}}%{{[0-9]+}}, 0, 1
+; CHECK: A_SCHEDULE_AGPR_B128 {{.*}}%{{[0-9]+}}, 4, 1
+define amdgpu_kernel void @after_exact(ptr addrspace(1) %out, <4 x half> %a, <4 x float> %c, <4 x float> %d) #0 {
+  %x = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %c, i32 0, i32 1)
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %a, <4 x float> %d, i32 0, i32 0, i32 0)
+  %p = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r, i32 -1, i32 1)
+  %o1 = getelementptr <4 x float>, ptr addrspace(1) %out, i32 1
+  store <4 x float> %x, ptr addrspace(1) %out
+  store <4 x float> %p, ptr addrspace(1) %o1
+  ret void
+}
+
+; A soft pin with regnum -1 gets no index.
+; CHECK-LABEL: name: soft_any
+; CHECK-NOT: A_SCHEDULE_AGPR
+; CHECK: S_ENDPGM
+define amdgpu_kernel void @soft_any(ptr addrspace(1) %out, <4 x half> %a, <4 x float> %c) #0 {
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %a, <4 x float> %c, i32 0, i32 0, i32 0)
+  %p = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r, i32 -1, i32 0)
+  store <4 x float> %p, ptr addrspace(1) %out
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="256,256" "amdgpu-waves-per-eu"="1" }
diff --git a/llvm/test/CodeGen/AMDGPU/sched-agpr-mfma-form.ll b/llvm/test/CodeGen/AMDGPU/sched-agpr-mfma-form.ll
new file mode 100644
index 0000000000..6a443a2232
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-agpr-mfma-form.ll
@@ -0,0 +1,64 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx950 -stop-after=finalize-isel < %s | FileCheck -check-prefix=ISEL %s
+; RUN: llc -mtriple=amdgcn -mcpu=gfx950 < %s | FileCheck -check-prefix=GCN %s
+
+; An MFMA whose src2 or result is strictly pinned by sched.agpr is selected in
+; the AGPR form even when the function is not known to need AGPRs, so the
+; accumulator stays in place instead of being copied to and from VGPRs around
+; the MFMA. Soft pins and unpinned MFMAs keep the default VGPR form.
+
+declare <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float>, i32, i32)
+declare <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half>, <4 x half>, <4 x float>, i32, i32, i32)
+
+; ISEL-LABEL: name: strict_pin
+; ISEL: V_MFMA_F32_16X16X16F16_e64
+; ISEL: V_MFMA_F32_16X16X16F16_e64
+; ISEL-NOT: V_MFMA_F32_16X16X16F16_vgprcd_e64
+; GCN-LABEL: {{^}}strict_pin:
+; GCN-NOT: v_accvgpr_read
+; GCN: v_mfma_f32_16x16x16_f16 a[8:11], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[8:11]
+; GCN-NOT: v_accvgpr_read
+; GCN: v_mfma_f32_16x16x16_f16 a[8:11], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[8:11]
+define amdgpu_kernel void @strict_pin(ptr addrspace(1) %out, <4 x half> %a, <4 x half> %b, <4 x float> %c) #0 {
+  %cin = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %c, i32 8, i32 1)
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %b, <4 x float> %cin, i32 0, i32 0, i32 0)
+  %rp = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r, i32 8, i32 1)
+  %cin2 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %rp, i32 8, i32 1)
+  %r2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %b, <4 x half> %a, <4 x float> %cin2, i32 0, i32 0, i32 0)
+  %rp2 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r2, i32 8, i32 1)
+  store <4 x float> %rp2, ptr addrspace(1) %out
+  ret void
+}
+
+; A strict pin with regnum -1 also selects the AGPR form; the allocator picks
+; the AGPRs.
+; ISEL-LABEL: name: any_pin
+; ISEL: V_MFMA_F32_16X16X16F16_e64
+; ISEL-NOT: V_MFMA_F32_16X16X16F16_vgprcd_e64
+; GCN-LABEL: {{^}}any_pin:
+; GCN: v_mfma_f32_16x16x16_f16 a[{{[0-9:]+}}], v[{{[0-9:]+}}], v[{{[0-9:]+}}], a[{{[0-9:]+}}]
+define amdgpu_kernel void @any_pin(ptr addrspace(1) %out, <4 x half> %a, <4 x half> %b, <4 x float> %c) #0 {
+  %cin = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %c, i32 -1, i32 1)
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %b, <4 x float> %cin, i32 0, i32 0, i32 0)
+  %rp = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %r, i32 -1, i32 1)
+  store <4 x float> %rp, ptr addrspace(1) %out
+  ret void
+}
+
+; ISEL-LABEL: name: soft_pin
+; ISEL: V_MFMA_F32_16X16X16F16_vgprcd_e64
+define amdgpu_kernel void @soft_pin(ptr addrspace(1) %out, <4 x half> %a, <4 x half> %b, <4 x float> %c) #0 {
+  %cin = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %c, i32 8, i32 0)
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %b, <4 x float> %cin, i32 0, i32 0, i32 0)
+  store <4 x float> %r, ptr addrspace(1) %out
+  ret void
+}
+
+; ISEL-LABEL: name: unpinned
+; ISEL: V_MFMA_F32_16X16X16F16_vgprcd_e64
+define amdgpu_kernel void @unpinned(ptr addrspace(1) %out, <4 x half> %a, <4 x half> %b, <4 x float> %c) #0 {
+  %r = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x16f16(<4 x half> %a, <4 x half> %b, <4 x float> %c, i32 0, i32 0, i32 0)
+  store <4 x float> %r, ptr addrspace(1) %out
+  ret void
+}
+
+attributes #0 = { "amdgpu-agpr-alloc"="0" "amdgpu-flat-work-group-size"="256,256" "amdgpu-waves-per-eu"="1" }
diff --git a/llvm/test/CodeGen/AMDGPU/sched-agpr.ll b/llvm/test/CodeGen/AMDGPU/sched-agpr.ll
new file mode 100644
index 0000000000..3334a0df59
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-agpr.ll
@@ -0,0 +1,92 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx942 < %s | FileCheck -check-prefix=GCN %s
+
+; sched_agpr's regnum is an architectural AGPR index (aN), not a unified-file
+; offset. vN and aN share a HW index, so a strict hint must also constrain the
+; register file. The strict pseudo stays through coalescing (its AGPR operand
+; class blocks inflation to AV_*) and is expanded after RA.
+
+declare i32 @llvm.amdgcn.sched.agpr.i32(i32, i32, i32)
+declare <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float>, i32, i32)
+
+; --------------------------------------------------------------------------
+; Result is only used by VALU. strict hint 8 still lands on a8; VALU reads it
+; back into a VGPR.
+
+; GCN-LABEL: {{^}}agpr8_as_vgpr:
+; GCN: v_accvgpr_write_b32 a8,
+; GCN: v_accvgpr_read_b32 v{{[0-9]+}}, a8
+; GCN: v_add_u32_e32
+; GCN: .Lagpr8_as_vgpr.num_agpr, 9
+define amdgpu_kernel void @agpr8_as_vgpr(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.agpr.i32(i32 %x, i32 8, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; Same hint, but the result is consumed as an AGPR. Lands on a8.
+
+; GCN-LABEL: {{^}}agpr8_kept:
+; GCN: v_accvgpr_write_b32 a8,
+; GCN: .Lagpr8_kept.num_agpr, 9
+define amdgpu_kernel void @agpr8_kept(i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.agpr.i32(i32 %x, i32 8, i32 1)
+  call void asm sideeffect "; use $0", "a"(i32 %h)
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; 128-bit value, strict hint 4, AGPR use. Starting index is a4: a[4:7].
+
+; GCN-LABEL: {{^}}agpr4_v4:
+; GCN-DAG: v_accvgpr_write_b32 a4,
+; GCN-DAG: v_accvgpr_write_b32 a5,
+; GCN-DAG: v_accvgpr_write_b32 a6,
+; GCN-DAG: v_accvgpr_write_b32 a7,
+; GCN: .Lagpr4_v4.num_agpr, 8
+define amdgpu_kernel void @agpr4_v4(ptr addrspace(1) %in) #0 {
+  %x = load <4 x float>, ptr addrspace(1) %in
+  %h = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %x, i32 4, i32 1)
+  call void asm sideeffect "; use $0", "a"(<4 x float> %h)
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; regnum 0 is a real a0, not "no hint".
+
+; GCN-LABEL: {{^}}agpr0_kept:
+; GCN: v_accvgpr_write_b32 a0,
+; GCN: .Lagpr0_kept.num_agpr, 1
+define amdgpu_kernel void @agpr0_kept(i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.agpr.i32(i32 %x, i32 0, i32 1)
+  call void asm sideeffect "; use $0", "a"(i32 %h)
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; regnum -1 keeps the value in the AGPR file without fixing the index. A soft
+; pin with regnum -1 has no effect.
+
+; GCN-LABEL: {{^}}agpr_any_as_vgpr:
+; GCN: v_accvgpr_write_b32 [[A:a[0-9]+]],
+; GCN: v_accvgpr_read_b32 v{{[0-9]+}}, [[A]]
+; GCN: v_add_u32_e32
+define amdgpu_kernel void @agpr_any_as_vgpr(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.agpr.i32(i32 %x, i32 -1, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; GCN-LABEL: {{^}}agpr_any_soft:
+; GCN-NOT: v_accvgpr_write
+; GCN: .Lagpr_any_soft.num_agpr, 0
+define amdgpu_kernel void @agpr_any_soft(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.agpr.i32(i32 %x, i32 -1, i32 0)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="64,64" "amdgpu-waves-per-eu"="1,1" }
diff --git a/llvm/test/CodeGen/AMDGPU/sched-bank-hints.mir b/llvm/test/CodeGen/AMDGPU/sched-bank-hints.mir
new file mode 100644
index 0000000000..b1b5b9bc05
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-bank-hints.mir
@@ -0,0 +1,35 @@
+# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-sched-bank -o - %s | FileCheck %s
+
+# The AMDGPUSchedBank pass attaches a bank register-allocation hint (not
+# printed in MIR) and lowers each V_SCHEDULE_BANK_B* pseudo to a plain COPY.
+
+---
+# CHECK-LABEL: name: lower_sched_bank_b32
+# CHECK: %1:vgpr_32 = COPY %0
+# CHECK-NOT: V_SCHEDULE_BANK_B32
+name: lower_sched_bank_b32
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:vgpr_32 = V_SCHEDULE_BANK_B32 %0, 2, implicit $exec
+    %2:vgpr_32 = V_ADD_U32_e32 1, %1, implicit $exec
+    $vgpr0 = COPY %2
+    SI_RETURN_TO_EPILOG $vgpr0
+...
+
+---
+# CHECK-LABEL: name: lower_sched_bank_b64
+# CHECK: %1:vreg_64_align2 = COPY %0
+# CHECK-NOT: V_SCHEDULE_BANK_B64
+name: lower_sched_bank_b64
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0_vgpr1
+    %0:vreg_64_align2 = COPY $vgpr0_vgpr1
+    %1:vreg_64_align2 = V_SCHEDULE_BANK_B64 %0, 3, implicit $exec
+    $vgpr0_vgpr1 = COPY %1
+    SI_RETURN_TO_EPILOG $vgpr0_vgpr1
+...
diff --git a/llvm/test/CodeGen/AMDGPU/sched-bank.ll b/llvm/test/CodeGen/AMDGPU/sched-bank.ll
new file mode 100644
index 0000000000..c60a73ff8c
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-bank.ll
@@ -0,0 +1,32 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx1250 < %s | FileCheck -check-prefix=GCN %s
+
+; Verify that llvm.amdgcn.sched.bank steers register allocation into the
+; requested 256-register bank. The kernel is pinned to occupancy 1
+; (waves-per-eu=1,1 with a single-wave workgroup) so the whole 1024-VGPR file is
+; addressable and the high banks are actually available to the allocator.
+
+declare i32 @llvm.amdgcn.sched.bank.i32(i32, i32)
+
+; A bank-2 hint places the value in v512-v767 and forces an s_set_vgpr_msb that
+; latches bank 2 (src1=2) around its use.
+; GCN-LABEL: {{^}}bank2:
+; GCN: v_mov_b32_e32 v0 /*v512*/, s2
+; GCN: s_set_vgpr_msb 0x8008
+define amdgpu_kernel void @bank2(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.bank.i32(i32 %x, i32 2)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; Without the hint the value stays in bank 0 and no bank switch is emitted.
+; GCN-LABEL: {{^}}nohint:
+; GCN-NOT: s_set_vgpr_msb
+; GCN: s_endpgm
+define amdgpu_kernel void @nohint(ptr addrspace(1) %out, i32 %x) #0 {
+  %y = add i32 %x, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="32,32" "amdgpu-waves-per-eu"="1,1" }
diff --git a/llvm/test/CodeGen/AMDGPU/sched-gpr-hints.mir b/llvm/test/CodeGen/AMDGPU/sched-gpr-hints.mir
new file mode 100644
index 0000000000..3a055fea21
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-gpr-hints.mir
@@ -0,0 +1,86 @@
+# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-sched-bank -o - %s | FileCheck %s
+
+# The AMDGPUSchedBank pass attaches exact register allocation hints (not
+# printed in MIR). Soft pins are lowered to a plain COPY; strict pins keep the
+# pseudo until expandPostRAPseudo. Strict schedule pseudos tie $vdst/$sdst to
+# $src so RA assigns one physreg and expandPostRA does not emit a real copy.
+
+---
+# CHECK-LABEL: name: lower_sched_vgpr_b32
+# CHECK: %1:vgpr_32 = V_SCHEDULE_VGPR_B32 %0, 42, 1
+name: lower_sched_vgpr_b32
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:vgpr_32 = V_SCHEDULE_VGPR_B32 %0, 42, 1, implicit $exec
+    %2:vgpr_32 = V_ADD_U32_e32 1, %1, implicit $exec
+    $vgpr0 = COPY %2
+    SI_RETURN_TO_EPILOG $vgpr0
+...
+
+---
+# CHECK-LABEL: name: lower_sched_vgpr_b64
+# CHECK: %1:vreg_64_align2 = COPY %0
+# CHECK-NOT: V_SCHEDULE_VGPR_B64
+name: lower_sched_vgpr_b64
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0_vgpr1
+    %0:vreg_64_align2 = COPY $vgpr0_vgpr1
+    %1:vreg_64_align2 = V_SCHEDULE_VGPR_B64 %0, 100, 0, implicit $exec
+    $vgpr0_vgpr1 = COPY %1
+    SI_RETURN_TO_EPILOG $vgpr0_vgpr1
+...
+
+---
+# CHECK-LABEL: name: lower_sched_sgpr_b32
+# CHECK: %1:sgpr_32 = S_SCHEDULE_SGPR_B32 %0, 10, 1
+name: lower_sched_sgpr_b32
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $sgpr0
+    %0:sgpr_32 = COPY $sgpr0
+    %1:sgpr_32 = S_SCHEDULE_SGPR_B32 %0, 10, 1
+    %2:sgpr_32 = S_ADD_I32 %1, 1, implicit-def $scc
+    $sgpr0 = COPY %2
+    SI_RETURN_TO_EPILOG $sgpr0
+...
+
+---
+# CHECK-LABEL: name: lower_sched_sgpr_b64
+# CHECK: %1:sgpr_64 = COPY %0
+# CHECK-NOT: S_SCHEDULE_SGPR_B64
+name: lower_sched_sgpr_b64
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $sgpr0_sgpr1
+    %0:sgpr_64 = COPY $sgpr0_sgpr1
+    %1:sgpr_64 = S_SCHEDULE_SGPR_B64 %0, 20, 0
+    $sgpr0_sgpr1 = COPY %1
+    SI_RETURN_TO_EPILOG $sgpr0_sgpr1
+...
+
+---
+# regnum -1 (any register of the file): a strict pin keeps the pseudo, a soft
+# pin is a plain COPY.
+# CHECK-LABEL: name: lower_sched_vgpr_any
+# CHECK: %1:vgpr_32 = V_SCHEDULE_VGPR_B32 %0, -1, 1
+# CHECK: %2:vgpr_32 = COPY %0
+# CHECK-NOT: V_SCHEDULE_VGPR_B32
+name: lower_sched_vgpr_any
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $vgpr0
+    %0:vgpr_32 = COPY $vgpr0
+    %1:vgpr_32 = V_SCHEDULE_VGPR_B32 %0, -1, 1, implicit $exec
+    %2:vgpr_32 = V_SCHEDULE_VGPR_B32 %0, -1, 0, implicit $exec
+    %3:vgpr_32 = V_ADD_U32_e32 %1, %2, implicit $exec
+    $vgpr0 = COPY %3
+    SI_RETURN_TO_EPILOG $vgpr0
+...
diff --git a/llvm/test/CodeGen/AMDGPU/sched-gpr-loop-carried.ll b/llvm/test/CodeGen/AMDGPU/sched-gpr-loop-carried.ll
new file mode 100644
index 0000000000..2627268254
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-gpr-loop-carried.ll
@@ -0,0 +1,167 @@
+; RUN: opt -mtriple=amdgcn -mcpu=gfx950 -passes=amdgpu-codegenprepare -S < %s | FileCheck -check-prefix=IR %s
+; RUN: llc -mtriple=amdgcn -mcpu=gfx950 < %s | FileCheck -check-prefix=GCN %s
+
+; A strict pin of a loop's initial value covers the whole loop-carried
+; variable: the updates inside the loop need no pin of their own and the
+; variable keeps one register across iterations.
+
+declare i32 @llvm.amdgcn.sched.vgpr.i32(i32, i32, i32)
+declare <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float>, i32, i32)
+declare <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float, float, <4 x float>, i32, i32, i32)
+declare i32 @llvm.amdgcn.workitem.id.x()
+
+; IR-LABEL: @vgpr_numbered(
+; IR: %c1 = add i32 %c, %x
+; IR-NEXT: call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %c1, i32 12, i32 1)
+; IR: %d1 = xor i32 %d, %y
+; IR-NEXT: call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %d1, i32 13, i32 1)
+
+; GCN-LABEL: vgpr_numbered:
+; GCN: .LBB0_1:
+; GCN-NOT: v_mov
+; GCN: v_add_u32_e32 v12, v12, v{{[0-9]+}}
+; GCN-NOT: v_mov
+; GCN: v_xor_b32_e32 v13, v13, v{{[0-9]+}}
+; GCN-NOT: v_mov
+; GCN: s_cbranch_scc1 .LBB0_1
+define amdgpu_kernel void @vgpr_numbered(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n) {
+entry:
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr i32, ptr addrspace(1) %in, i32 %tid
+  %x = load volatile i32, ptr addrspace(1) %p
+  %y = load volatile i32, ptr addrspace(1) %p
+  %z = load volatile i32, ptr addrspace(1) %p
+  %w = load volatile i32, ptr addrspace(1) %p
+  %c0 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %z, i32 12, i32 1)
+  %d0 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %w, i32 13, i32 1)
+  br label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i1, %loop]
+  %c = phi i32 [%c0, %entry], [%c1, %loop]
+  %d = phi i32 [%d0, %entry], [%d1, %loop]
+  %c1 = add i32 %c, %x
+  %d1 = xor i32 %d, %y
+  %i1 = add i32 %i, 1
+  %cc = icmp slt i32 %i1, %n
+  br i1 %cc, label %loop, label %exit
+exit:
+  %q = getelementptr i32, ptr addrspace(1) %out, i32 %tid
+  store volatile i32 %c1, ptr addrspace(1) %q
+  store volatile i32 %d1, ptr addrspace(1) %q
+  ret void
+}
+
+; IR-LABEL: @vgpr_any(
+; IR: %c1 = add i32 %c, %x
+; IR-NEXT: call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %c1, i32 -1, i32 1)
+
+; GCN-LABEL: vgpr_any:
+; GCN: .LBB1_1:
+; GCN-NOT: v_mov
+; GCN: v_add_u32_e32 [[C:v[0-9]+]], [[C]], v{{[0-9]+}}
+; GCN-NOT: v_mov
+; GCN: v_xor_b32_e32 [[D:v[0-9]+]], [[D]], v{{[0-9]+}}
+; GCN-NOT: v_mov
+; GCN: s_cbranch_scc1 .LBB1_1
+define amdgpu_kernel void @vgpr_any(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n) {
+entry:
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr i32, ptr addrspace(1) %in, i32 %tid
+  %x = load volatile i32, ptr addrspace(1) %p
+  %y = load volatile i32, ptr addrspace(1) %p
+  %z = load volatile i32, ptr addrspace(1) %p
+  %w = load volatile i32, ptr addrspace(1) %p
+  %c0 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %z, i32 -1, i32 1)
+  %d0 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %w, i32 -1, i32 1)
+  br label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i1, %loop]
+  %c = phi i32 [%c0, %entry], [%c1, %loop]
+  %d = phi i32 [%d0, %entry], [%d1, %loop]
+  %c1 = add i32 %c, %x
+  %d1 = xor i32 %d, %y
+  %i1 = add i32 %i, 1
+  %cc = icmp slt i32 %i1, %n
+  br i1 %cc, label %loop, label %exit
+exit:
+  %q = getelementptr i32, ptr addrspace(1) %out, i32 %tid
+  store volatile i32 %c1, ptr addrspace(1) %q
+  store volatile i32 %d1, ptr addrspace(1) %q
+  ret void
+}
+
+; Two MFMAs per iteration accumulate into each AGPR chain.
+
+; IR-LABEL: @agpr_any(
+; IR: %e2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(
+; IR-NEXT: call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %e2, i32 -1, i32 1)
+; IR: %e3 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(
+; IR-NEXT: call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %e3, i32 -1, i32 1)
+
+; GCN-LABEL: agpr_any:
+; GCN-NOT: v_accvgpr_mov
+; GCN: .LBB2_1:
+; GCN: v_mfma_f32_16x16x4_f32 a[0:3], v{{[0-9]+}}, v{{[0-9]+}}, a[0:3]
+; GCN: v_mfma_f32_16x16x4_f32 a[4:7], v{{[0-9]+}}, v{{[0-9]+}}, a[4:7]
+; GCN-NOT: v_accvgpr_mov
+; GCN: v_mfma_f32_16x16x4_f32 a[0:3], v{{[0-9]+}}, v{{[0-9]+}}, a[0:3]
+; GCN: v_mfma_f32_16x16x4_f32 a[4:7], v{{[0-9]+}}, v{{[0-9]+}}, a[4:7]
+; GCN-NOT: v_accvgpr_mov
+; GCN: s_cbranch_scc1 .LBB2_1
+define amdgpu_kernel void @agpr_any(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n) {
+entry:
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr float, ptr addrspace(1) %in, i32 %tid
+  %a = load volatile float, ptr addrspace(1) %p
+  %b = load volatile float, ptr addrspace(1) %p
+  %m0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %a, float %b, <4 x float> zeroinitializer, i32 0, i32 0, i32 0)
+  %e0 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %m0, i32 -1, i32 1)
+  %n0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %b, float %a, <4 x float> zeroinitializer, i32 0, i32 0, i32 0)
+  %f0 = call <4 x float> @llvm.amdgcn.sched.agpr.v4f32(<4 x float> %n0, i32 -1, i32 1)
+  br label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i1, %loop]
+  %e = phi <4 x float> [%e0, %entry], [%e3, %loop]
+  %f = phi <4 x float> [%f0, %entry], [%f3, %loop]
+  %e2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %a, float %b, <4 x float> %e, i32 0, i32 0, i32 0)
+  %f2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %b, float %a, <4 x float> %f, i32 0, i32 0, i32 0)
+  %e3 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %b, float %b, <4 x float> %e2, i32 0, i32 0, i32 0)
+  %f3 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x4f32(float %a, float %a, <4 x float> %f2, i32 0, i32 0, i32 0)
+  %i1 = add i32 %i, 1
+  %cc = icmp slt i32 %i1, %n
+  br i1 %cc, label %loop, label %exit
+exit:
+  %q = getelementptr <4 x float>, ptr addrspace(1) %out, i32 %tid
+  store volatile <4 x float> %e3, ptr addrspace(1) %q
+  store volatile <4 x float> %f3, ptr addrspace(1) %q
+  ret void
+}
+
+; Pins with different register numbers in one variable conflict: nothing is
+; added.
+
+; IR-LABEL: @conflict(
+; IR: %c1 = add i32 %c, %x
+; IR-NEXT: %c2 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %c1, i32 13, i32 1)
+; IR-NEXT: %i1 = add i32 %i, 1
+define amdgpu_kernel void @conflict(ptr addrspace(1) %out, ptr addrspace(1) %in, i32 %n) {
+entry:
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %p = getelementptr i32, ptr addrspace(1) %in, i32 %tid
+  %x = load volatile i32, ptr addrspace(1) %p
+  %z = load volatile i32, ptr addrspace(1) %p
+  %c0 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %z, i32 12, i32 1)
+  br label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i1, %loop]
+  %c = phi i32 [%c0, %entry], [%c2, %loop]
+  %c1 = add i32 %c, %x
+  %c2 = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %c1, i32 13, i32 1)
+  %i1 = add i32 %i, 1
+  %cc = icmp slt i32 %i1, %n
+  br i1 %cc, label %loop, label %exit
+exit:
+  %q = getelementptr i32, ptr addrspace(1) %out, i32 %tid
+  store volatile i32 %c2, ptr addrspace(1) %q
+  ret void
+}
diff --git a/llvm/test/CodeGen/AMDGPU/sched-gpr.ll b/llvm/test/CodeGen/AMDGPU/sched-gpr.ll
new file mode 100644
index 0000000000..8aee1fc038
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-gpr.ll
@@ -0,0 +1,153 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx1250 < %s | FileCheck -check-prefix=GCN %s
+
+; Verify that llvm.amdgcn.schedule.{vgpr,sgpr} steer register allocation to
+; the exact requested register number. Kernels are pinned to occupancy 1
+; (waves-per-eu=1,1 with a single-wave workgroup) so the whole 1024-VGPR file
+; is addressable and high-numbered registers are available to the allocator.
+
+declare i32 @llvm.amdgcn.sched.vgpr.i32(i32, i32, i32)
+declare i64 @llvm.amdgcn.sched.vgpr.i64(i64, i32, i32)
+declare <16 x float> @llvm.amdgcn.sched.vgpr.v16f32(<16 x float>, i32, i32)
+declare <4 x float> @llvm.amdgcn.sched.vgpr.v4f32(<4 x float>, i32, i32)
+declare i32 @llvm.amdgcn.sched.sgpr.i32(i32, i32, i32)
+declare i32 @llvm.amdgcn.workitem.id.x()
+
+; --------------------------------------------------------------------------
+; sched_vgpr: strict hint to v42
+
+; GCN-LABEL: {{^}}vgpr42:
+; GCN: v42
+define amdgpu_kernel void @vgpr42(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %x, i32 42, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: strict hint to v100
+
+; GCN-LABEL: {{^}}vgpr100:
+; GCN: v100
+define amdgpu_kernel void @vgpr100(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %x, i32 100, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: strict hint to v0
+
+; GCN-LABEL: {{^}}vgpr0:
+; GCN: v0,
+define amdgpu_kernel void @vgpr0(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %x, i32 0, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: strict hint to v512 (bank 2 territory)
+
+; GCN-LABEL: {{^}}vgpr512:
+; GCN: v512
+define amdgpu_kernel void @vgpr512(ptr addrspace(1) %out, i32 %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %x, i32 512, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: 64-bit value, strict hint to v[200:201]
+
+; GCN-LABEL: {{^}}vgpr200_64:
+; GCN: v[200:201]
+define amdgpu_kernel void @vgpr200_64(ptr addrspace(1) %out, i64 %x) #0 {
+  %h = call i64 @llvm.amdgcn.sched.vgpr.i64(i64 %x, i32 200, i32 1)
+  %y = add i64 %h, 1
+  store i64 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: 512-bit value (v16f32), strict hint to v[512:527]
+
+; GCN-LABEL: {{^}}vgpr512_v16f32:
+; GCN-DAG: v[524:527]
+; GCN-DAG: v[512:515]
+define amdgpu_kernel void @vgpr512_v16f32(ptr addrspace(1) %out, ptr addrspace(1) %in) #0 {
+  %x = load <16 x float>, ptr addrspace(1) %in
+  %h = call <16 x float> @llvm.amdgcn.sched.vgpr.v16f32(<16 x float> %x, i32 512, i32 1)
+  store <16 x float> %h, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; sched_vgpr: a strict pin on a value built from sub-register defs still holds
+; after coalescing, and every later use reads the pinned v[40:43].
+
+; GCN-LABEL: {{^}}vgpr40_shared_uses:
+; GCN-DAG: v_pk_add_f32 v[40:41],
+; GCN-DAG: v_pk_add_f32 v[42:43],
+; GCN-DAG: v_pk_add_f32 v[{{[0-9]+:[0-9]+}}], v[40:41],
+; GCN-DAG: v_pk_mul_f32 v[{{[0-9]+:[0-9]+}}], v[40:41],
+define amdgpu_kernel void @vgpr40_shared_uses(ptr addrspace(1) %out, ptr addrspace(1) %in) #0 {
+  %pb = getelementptr <4 x float>, ptr addrspace(1) %in, i32 1
+  %pe = getelementptr <4 x float>, ptr addrspace(1) %in, i32 2
+  %a = load volatile <4 x float>, ptr addrspace(1) %in
+  %b = load volatile <4 x float>, ptr addrspace(1) %pb
+  %e = load volatile <4 x float>, ptr addrspace(1) %pe
+  %c0 = fadd <4 x float> %a, %b
+  %c = call <4 x float> @llvm.amdgcn.sched.vgpr.v4f32(<4 x float> %c0, i32 40, i32 1)
+  %d = fadd <4 x float> %c, %e
+  %f = fmul <4 x float> %c, %e
+  %o2 = getelementptr <4 x float>, ptr addrspace(1) %out, i32 1
+  store <4 x float> %d, ptr addrspace(1) %out
+  store <4 x float> %f, ptr addrspace(1) %o2
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; regnum -1: any register of the file. No index is forced, so the allocator
+; keeps the default low-numbered registers.
+
+; GCN-LABEL: {{^}}vgpr_any:
+; GCN-NOT: v42
+; GCN: v_add_nc_u32_e32 v{{[0-9]}}, 1, v{{[0-9]}}
+define amdgpu_kernel void @vgpr_any(ptr addrspace(1) %out, i32 %x) #0 {
+  %v = call i32 @llvm.amdgcn.workitem.id.x()
+  %s = add i32 %v, %x
+  %h = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %s, i32 -1, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; GCN-LABEL: {{^}}sgpr_any:
+; GCN: s_add_co_i32 s{{[0-9]+}}, s{{[0-9]+}}, 1
+define amdgpu_kernel void @sgpr_any(ptr addrspace(1) %out, i32 inreg %x) #0 {
+  %h = call i32 @llvm.amdgcn.sched.sgpr.i32(i32 %x, i32 -1, i32 1)
+  %y = add i32 %h, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+; --------------------------------------------------------------------------
+; Without hint: register allocator uses default low-numbered registers.
+; Verify no high-numbered VGPRs appear.
+
+; GCN-LABEL: {{^}}nohint:
+; GCN-NOT: v42
+; GCN-NOT: v100
+; GCN-NOT: v512
+; GCN: s_endpgm
+define amdgpu_kernel void @nohint(ptr addrspace(1) %out, i32 %x) #0 {
+  %y = add i32 %x, 1
+  store i32 %y, ptr addrspace(1) %out
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="32,32" "amdgpu-waves-per-eu"="1,1" }
