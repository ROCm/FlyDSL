+  /// Scheduling budget left in each block that has a scheduling region.
+  using ScheduleBudgets = SmallDenseMap<BasicBlock *, int, 4>;
+  ScheduleBudgets saveScheduleBudgets() const {
+    ScheduleBudgets Budgets;
+    for (const auto &[BB, BS] : BlocksSchedules)
+      Budgets.try_emplace(BB, BS->ScheduleRegionSizeLimit -
+                                  BS->ScheduleRegionSize);
+    return Budgets;
+  }
+  /// Gives back the scheduling budget spent since \p Budgets was saved.
+  void restoreScheduleBudgets(const ScheduleBudgets &Budgets) {
+    for (auto &[BB, BS] : BlocksSchedules)
+      BS->ScheduleRegionSizeLimit =
+          Budgets.lookup_or(BB, ScheduleRegionSizeBudget) +
+          BS->ScheduleRegionSize;
+  }
