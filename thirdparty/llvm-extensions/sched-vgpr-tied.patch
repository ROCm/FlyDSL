 #include "llvm/CodeGen/MachineInstrBuilder.h"
 #include "llvm/CodeGen/MachineRegisterInfo.h"
 #include "llvm/InitializePasses.h"
+#include "llvm/Support/CommandLine.h"
 
 using namespace llvm;
 
 #define DEBUG_TYPE "amdgpu-sched-bank"
 
+// Off by default. A strict pin otherwise stays untied until after RA, and the
+// post-RA expansion copies src to dst whenever they were given different
+// physical registers. Turning this on ties them first, so the allocator
+// assigns one register and that copy is not emitted.
+static cl::opt<bool> TieStrictSchedPin(
+    "amdgpu-tie-strict-sched-pin", cl::Hidden, cl::init(false),
+    cl::desc("Tie strict sched.vgpr/sgpr/agpr src to dst"));
