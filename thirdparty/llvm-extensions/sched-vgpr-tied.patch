+++ b/llvm/lib/Target/AMDGPU/SIInstrInfo.cpp
@@ -2566,7 +2566,8 @@ bool SIInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
   case AMDGPU::S_SCHEDULE_SGPR_B256:
   case AMDGPU::S_SCHEDULE_SGPR_B512: {
     // Strict exact-register pins are kept through RA so the pinned value keeps
-    // its own def and hint (and, for AGPR, its operand class).
+    // its own def and hint (and, for AGPR, its operand class). If src was tied
+    // to dst, the physical registers match and this emits no copy.
     // The immediates have already been consumed as allocation hints.
     Register Dst = MI.getOperand(0).getReg();
     Register Src = MI.getOperand(1).getReg();
diff --git a/llvm/test/CodeGen/AMDGPU/sched-gpr-tied.ll b/llvm/test/CodeGen/AMDGPU/sched-gpr-tied.ll
new file mode 100644
index 0000000000..5a40b20cc7
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/sched-gpr-tied.ll
@@ -0,0 +1,32 @@
+; RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -stop-after=amdgpu-sched-bank -amdgpu-tie-strict-sched-pin < %s | FileCheck -check-prefix=TIED %s
+; RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -stop-after=amdgpu-sched-bank < %s | FileCheck -check-prefix=UNTIED %s
+; RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -amdgpu-tie-strict-sched-pin < %s | FileCheck -check-prefix=GCN %s
+
+; -amdgpu-tie-strict-sched-pin ties a strict sched.vgpr pin's source to its
+; result before RA. The defining instruction then writes the pinned register,
+; and later uses read that register with no copy in between. The switch
+; defaults off, which leaves the pseudo untied.
+
+declare i32 @llvm.amdgcn.sched.vgpr.i32(i32, i32, i32)
+declare i32 @llvm.amdgcn.workitem.id.x()
+
+; TIED: V_SCHEDULE_VGPR_B32 killed %{{[0-9]+}}(tied-def 0), 40, 1
+; UNTIED: V_SCHEDULE_VGPR_B32 killed %{{[0-9]+}}, 40, 1
+; UNTIED-NOT: tied-def
+; GCN-LABEL: {{^}}vgpr40_tied:
+; GCN: v_dual_add_nc_u32 v40,
+; GCN-NOT: v_mov
+; GCN: v_dual_add_nc_u32 v{{[0-9]+}}, {{[^,]+}}, v40
+define amdgpu_kernel void @vgpr40_tied(ptr addrspace(1) %out, i32 %x, i32 %y) #0 {
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %sum = add i32 %tid, %x
+  %pinned = call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %sum, i32 40, i32 1)
+  %a = add i32 %pinned, %y
+  %b = xor i32 %pinned, %y
+  store i32 %a, ptr addrspace(1) %out
+  %out2 = getelementptr i32, ptr addrspace(1) %out, i32 1
+  store i32 %b, ptr addrspace(1) %out2
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="32,32" "amdgpu-waves-per-eu"="1,1" }
