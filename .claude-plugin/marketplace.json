    "name": "FlyDSL Project Contributors"
  },
  "metadata": {
    "description": "Claude Code plugins for FlyDSL, the layout-centric Python DSL for AMD GPU kernels"
  },
  "plugins": [
    {
      "name": "flydsl",
      "source": "./",
